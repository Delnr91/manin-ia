# =============================================================================
# manin-ia Engine — Environment Variables
# =============================================================================
# Copy this file to .env and replace ALL placeholder values before deploying.
#
#   cp .env.example .env
#   nano .env
#
# ⚠  NEVER commit the .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Domain Configuration
# -----------------------------------------------------------------------------
# Your base domain. Caddy will serve:
#   - https://n8n.<DOMAIN>     → n8n workflow UI
#   - https://ollama.<DOMAIN>  → Ollama LLM API
#
# Make sure DNS A records for both subdomains point to your server's public IP.
DOMAIN=yourdomain.com

# Email address for Let's Encrypt / ZeroSSL TLS certificate registration.
# You'll receive expiry warnings at this address.
ADMIN_EMAIL=admin@yourdomain.com

# -----------------------------------------------------------------------------
# n8n — Workflow Engine
# -----------------------------------------------------------------------------
# Encryption key for n8n's credential store. This encrypts all saved API keys,
# passwords, and tokens inside n8n's database.
#
# Generate a secure value:
#   openssl rand -hex 32
#
# ⚠  If you lose this key, all saved credentials in n8n become unrecoverable.
#    Back it up securely.
N8N_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# -----------------------------------------------------------------------------
# Ollama — LLM API Access
# -----------------------------------------------------------------------------
# API key that protects the Ollama endpoint. Clients must send this value
# in the X-API-Key HTTP header to access the LLM.
#
# Generate a secure value:
#   openssl rand -hex 16
#
# Share this key only with trusted frontend/backend services.
OLLAMA_API_KEY=change-me-generate-with-openssl-rand-hex-16

# -----------------------------------------------------------------------------
# PostgreSQL — Database
# -----------------------------------------------------------------------------
# Credentials for the PostgreSQL instance used by n8n and future services.
#
# Choose a strong password:
#   openssl rand -base64 24
POSTGRES_USER=manin
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-base64-24
